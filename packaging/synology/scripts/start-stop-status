#!/bin/sh
# Package Center calls this with start, stop, status and log.
TARGET=/var/packages/iroh-share/target
VAR=/var/packages/iroh-share/var
[ -d "$VAR" ] || VAR=$TARGET/var
PID=$VAR/daemon.pid
LOG=$VAR/daemon.log
CLI=$TARGET/bin/iroh-share

running() {
    [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null
}

case "$1" in
    start)
        running && exit 0
        mkdir -p "$VAR"
        [ -f "$LOG" ] && mv -f "$LOG" "$VAR/daemon.previous.log"
        # The provider at debug logs each request and why it failed; peers
        # only see an error code. Override with a RUST_LOG value in
        # $VAR/rust_log.
        RUST_LOG=info,iroh_blobs::provider=debug
        [ -f "$VAR/rust_log" ] && RUST_LOG=$(cat "$VAR/rust_log")
        # Ticket imports default to $HOME/Downloads/Iroh Share.
        HOME=$VAR RUST_LOG=$RUST_LOG nohup "$CLI" daemon --no-pairing-ticket >> "$LOG" 2>&1 &
        echo $! > "$PID"
        ;;
    stop)
        if running; then
            HOME=$VAR "$CLI" control stop >> "$LOG" 2>&1 || kill "$(cat "$PID")"
            for _ in $(seq 30); do running || break; sleep 1; done
            running && kill -9 "$(cat "$PID")"
        fi
        rm -f "$PID"
        ;;
    status)
        running || exit 3
        ;;
    log)
        # Package Center shows this file under View Log. It starts with a fresh
        # single-use pairing ticket, which daemon.log deliberately never has.
        OUT=$VAR/package.log
        umask 077
        {
            if running; then
                echo "Pairing ticket for a GUI or TUI (single use):"
                HOME=$VAR "$CLI" control pair 2>&1
            else
                echo "iroh-share is not running."
            fi
            echo
            tail -n 200 "$LOG" 2>/dev/null
        } > "$OUT"
        echo "$OUT"
        ;;
esac
exit 0
